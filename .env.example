# Public site identity
NEXT_PUBLIC_APP_NAME=TATD
NEXT_PUBLIC_APP_URL=

# Public data mode: SNAPSHOT | CONNECTED | UNAVAILABLE
PUBLIC_DATA_MODE=SNAPSHOT

# Snapshot bundle written by the private runtime exporter.
PUBLIC_SNAPSHOT_PATH=public/data/snapshot.json

# Optional connected projection. Server-side only. Never expose in NEXT_PUBLIC_*.
PUBLIC_PROJECTION_BASE_URL=
PUBLIC_PROJECTION_READ_TOKEN=

# Deliberately not configured here:
# BITQUERY_API_KEY, VIRLO_API_KEY, OPENROUTER_API_KEY,
# WALLET_PRIVATE_KEY, TRADING_SIGNER_KEY, WALLET_MNEMONIC
