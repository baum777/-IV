{
  "name": "tatd-observatory",
  "version": "1.0.0",
  "private": true,
  "description": "TATD public observatory — read-only proof-of-concept trading desk.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "export:snapshot": "python3 -m public_projection --db \"${TATD_DB:-.tatd-cache/demo.sqlite3}\" --out public/data"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "motion": "12.0.0",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "recharts": "2.15.0",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
